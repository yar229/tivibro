<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- DayNight is what lets the "Color theme" setting work: the dark palette lives in
         values-night, the light one in values, and uiMode picks between them. -->
    <style name="Theme.TvBro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:colorBackground">@color/bg_app</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Base for all dot-separated TvBro.* styles: AAPT resolves "TvBro.Text.Title"
         through the implied parents TvBro.Text -> TvBro, so the root must exist. -->
    <style name="TvBro" parent="@android:style/Widget.TextView" />

    <style name="Theme.TvBro.Player" parent="Theme.TvBro">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.TvBro.Dialog" parent="Theme.TvBro">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- Settings slides in as a translucent panel over the window below it -->
    <style name="Theme.TvBro.Settings" parent="Theme.TvBro">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="TvBro.Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
    </style>

    <style name="TvBro.Text.Subtitle" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TvBro.Text.Time" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TvBro.Text.Channel" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
    </style>

    <style name="TvBro.Text.Program" parent="">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
    </style>

    <style name="TvBro.NavItem">
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="TvBro.NavItemLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/nav_label_inactive</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TvBro.DialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TvBro.DialogText" parent="">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TvBro.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
    </style>

    <style name="TvBro.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="TvBro.PlayerButton" parent="">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_player_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/spacing_md</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="TvBro.TimeElapsed" parent="">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TvBro.TimeTotal" parent="">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TvBro.Badge" parent="">
        <item name="android:textSize">@dimen/text_xxs</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingLeft">@dimen/spacing_sm</item>
        <item name="android:paddingRight">@dimen/spacing_sm</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>

    <style name="TvBro.EpgProgramTitle" parent="">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
    </style>

    <style name="TvBro.EpgProgramTime" parent="">
        <item name="android:textSize">@dimen/text_xxs</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="TvBro.PreferenceCategory" parent="">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TvBro.PreferenceCategoryTitle</item>
    </style>

    <style name="TvBro.PreferenceCategoryTitle" parent="">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TvBro.Preference" parent="">
        <item name="android:layout">@layout/preference_row</item>
    </style>

    <style name="TvBro.SettingsHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/header_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TvBro.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>
</resources>
