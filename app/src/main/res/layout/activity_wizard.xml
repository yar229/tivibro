<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wizard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="480dp"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_panel"
    android:padding="@dimen/spacing_lg">

    <TextView
        android:id="@+id/wizard_title"
        style="@style/TvBro.DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Playlist type" />

    <TextView
        android:id="@+id/wizard_message"
        style="@style/TvBro.DialogText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:visibility="gone"
        tools:text="Select the playlist type" />

    <!-- Shown while a stored playlist is being edited: the type is part of what can be corrected. -->
    <TextView
        android:id="@+id/wizard_type"
        style="@style/TvBro.NavItemLabel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@drawable/bg_group_item"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:visibility="gone"
        tools:text="Type: Xtream Codes" />

    <!-- The fields grow with the chosen type and are the only part of the form that may give way: the
         scroller around them is capped in code to what the window has room for, so the button row
         below always keeps its full height and its text stays whole. -->
    <ScrollView
        android:id="@+id/wizard_fields_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/wizard_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- The buttons are the last thing in the layout and were the first to be cut off, so the row
         keeps a full touch target even if the window has to give height to the fields above. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:minHeight="@dimen/touch_target"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wizard_status"
            style="@style/TvBro.Text.Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:visibility="gone"
            tools:text="Connected" />

        <Button
            android:id="@+id/button_test"
            style="@style/TvBro.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center_vertical"
            android:text="@string/test_connection"
            android:visibility="gone" />

        <Button
            android:id="@+id/button_cancel"
            style="@style/TvBro.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center_vertical"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/button_ok"
            style="@style/TvBro.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center_vertical"
            android:text="@string/next" />
    </LinearLayout>
</LinearLayout>
