<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:background="@drawable/osd_scrim_bottom">

        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_live_tv"
            app:tint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/TvBro.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/subtitle"
                style="@style/TvBro.Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="1st Playlist / Sports" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/days_list"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:clipToPadding="false"
            android:nextFocusDown="@id/guide_channels_list"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/clock_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock"
                style="@style/TvBro.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="20:15" />

            <TextView
                android:id="@+id/clock_date"
                style="@style/TvBro.Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Sat, 12 Oct" />
        </LinearLayout>
    </LinearLayout>

    <!-- Programme details, a strip of its own above the guide: it must never cover the grid -->
    <LinearLayout
        android:id="@+id/guide_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_app"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/guide_info_programme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/guide_info_title"
                    style="@style/TvBro.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/guide_info_title_width"
                    android:textSize="@dimen/text_lg"
                    tools:text="Live: Premier League" />

                <TextView
                    android:id="@+id/guide_info_time"
                    style="@style/TvBro.Text.Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_sm"
                    tools:text="20:15 - 21:00 · 62% · -0:23" />
            </LinearLayout>

            <!-- Head of the description: the lines that fit beside the programme -->
            <TextView
                android:id="@+id/guide_info_description"
                style="@style/TvBro.Text.Subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="@dimen/guide_info_description_text"
                tools:text="Live coverage of the match from the commentary booth." />
        </LinearLayout>

        <!-- Tail of the description: continues under the programme, across the full width.
             No top margin, otherwise the flow around the title shows a seam. -->
        <TextView
            android:id="@+id/guide_info_description_tail"
            style="@style/TvBro.Text.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:textSize="@dimen/guide_info_description_text"
            android:visibility="gone"
            tools:text="booth, with interviews before and after the game." />

        <!-- Separates the panel from the schedule below it -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@color/divider" />
    </LinearLayout>

    <!-- Content: menu strip (left arrow twice) | groups (left arrow once) | guide -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/menu_strip"
            android:layout_width="@dimen/nav_strip_width"
            android:layout_height="match_parent"
            android:background="@drawable/osd_scrim_top"
            android:nextFocusRight="@id/groups_list"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xs"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_sm"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/groups_list"
            android:layout_width="@dimen/card_size"
            android:layout_height="match_parent"
            android:background="@drawable/osd_scrim_top"
            android:clipToPadding="false"
            android:nextFocusRight="@id/guide_channels_list"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            android:scrollbars="none"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/guide_channels_list"
                android:layout_width="@dimen/guide_channel_column"
                android:layout_height="match_parent"
                android:background="@drawable/osd_scrim_top"
                android:scrollbars="none" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/grid_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.tvibro.ui.main.guide.TimeRulerView
                    android:id="@+id/time_ruler"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/epg_ruler_height" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/programs_rows"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none" />

                    <TextView
                        android:id="@+id/empty_view"
                        style="@style/TvBro.Text.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="@dimen/spacing_xl"
                        android:text="@string/no_channels"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/now_line"
                        android:layout_width="@dimen/epg_now_line"
                        android:layout_height="match_parent"
                        android:background="@color/accent"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom status line -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs"
        android:background="@drawable/osd_scrim_bottom">

        <TextView
            android:id="@+id/status_text"
            style="@style/TvBro.Text.Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="150 channels" />

        <TextView
            android:id="@+id/status_hint"
            style="@style/TvBro.Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/press_ok_to_turn_on" />
    </LinearLayout>
</LinearLayout>
