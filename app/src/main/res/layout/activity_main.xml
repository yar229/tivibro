<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true">

    <!-- No top bar: the logo, the app name and the playlist/category line took a whole strip for
         information the guide does not need. The current time sits next to the name of the
         programme below instead, and the day is written on the scale of the grid itself. -->

    <!-- Programme details and the picture of the running stream, a strip of its own above the
         guide: it must never cover the grid. Its height is a fraction of the screen (a bit less
         than a third), set in code, so the same proportion holds on the TV and on the tablet. The
         description is cut instead of the strip growing. -->
    <LinearLayout
        android:id="@+id/guide_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_app"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <!-- The stream that was left running shows up here, without being restarted. The slot keeps
             its place and its size in every state, so without a stream it shows the sign of a
             television instead of an empty hole. -->
        <FrameLayout
            android:id="@+id/guide_info_slot"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:background="@color/panel_solid">

            <ImageView
                android:id="@+id/guide_info_placeholder"
                android:layout_width="@dimen/guide_info_placeholder_size"
                android:layout_height="@dimen/guide_info_placeholder_size"
                android:layout_gravity="center"
                android:alpha="0.35"
                android:contentDescription="@null"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tv" />

            <FrameLayout
                android:id="@+id/guide_info_player"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/guide_info_programme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Name of the programme on the left, the current time on the right of it: both belong together,
                     and the date is not repeated here because the scale of the grid carries the day. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/guide_info_title"
                        style="@style/TvBro.Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxWidth="@dimen/guide_info_title_width"
                        android:singleLine="true"
                        android:textSize="@dimen/text_lg"
                        tools:text="Live: Premier League" />

                    <TextView
                        android:id="@+id/clock"
                        style="@style/TvBro.Text.Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_lg"
                        tools:text="20:15" />
                </LinearLayout>

                <!-- Time, how much of it is over and how much is left, the same three parts the
                     bottom panel of the player uses: a bar carries the progress, so no percentage
                     has to be read as text. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/guide_info_time"
                        style="@style/TvBro.Text.Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_sm"
                        tools:text="20:15 - 21:00" />

                    <ProgressBar
                        android:id="@+id/guide_info_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="80dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:progressDrawable="@drawable/progress_switch" />

                    <TextView
                        android:id="@+id/guide_info_remaining"
                        style="@style/TvBro.Text.Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_sm"
                        tools:text="-0:23" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/guide_info_description"
                style="@style/TvBro.Text.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_xs"
                android:layout_weight="1"
                android:ellipsize="end"
                android:textSize="@dimen/guide_info_description_text"
                tools:text="Live coverage of the match from the commentary booth." />
        </LinearLayout>
    </LinearLayout>

    <!-- The line that ends the strip. It is a sibling and not a border of the panel, so the strip
         keeps the exact height of the video slot. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Content: menu strip (left arrow twice) | groups (left arrow once) | guide -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/menu_strip"
            android:layout_width="@dimen/nav_strip_width"
            android:layout_height="match_parent"
            android:background="@drawable/osd_scrim_top"
            android:nextFocusRight="@id/groups_list"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xs"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_sm"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/groups_column"
            android:layout_width="@dimen/groups_column_width"
            android:layout_height="match_parent"
            android:background="@drawable/osd_scrim_top"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Touch has no Left key, so the column carries the button that peels the next one
                 open. It is hidden once there is nothing left to show. -->
            <LinearLayout
                android:id="@+id/menu_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/epg_ruler_height"
                android:background="@drawable/bg_player_button"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_left" />

                <TextView
                    style="@style/TvBro.Text.Time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/show_menu" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/groups_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:nextFocusRight="@id/guide_channels_list"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_sm"
                android:scrollbars="none" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- The time scale belongs to the grid, but it must not push the grid down: the channel
                 column has to start on the very same line as the first row of programmes, or every
                 channel name would sit one scale height above its own programmes. The button that
                 opens the groups column sits in that empty corner, and so does the corner itself
                 when there is nothing left to open, so both lists keep sharing one top edge. -->
            <LinearLayout
                android:layout_width="@dimen/guide_channel_column"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/epg_ruler_height">

                    <LinearLayout
                        android:id="@+id/groups_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_player_button"
                        android:clickable="true"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_sm"
                        android:paddingEnd="@dimen/spacing_sm">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_left" />

                        <TextView
                            style="@style/TvBro.Text.Time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/categories" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/guide_channels_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/osd_scrim_top"
                    android:scrollbars="none" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/grid_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Drawn in place rather than moved over the grid: it repaints on every change of the shared
                     offset, which is what keeps its ticks and its day label on the same moment. -->
                <com.tvibro.ui.main.guide.TimeRulerView
                    android:id="@+id/time_ruler"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/epg_ruler_height"
                    android:focusable="false"
                    android:focusableInTouchMode="false" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/programs_rows"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none" />

                    <TextView
                        android:id="@+id/empty_view"
                        style="@style/TvBro.Text.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="@dimen/spacing_xl"
                        android:text="@string/no_channels"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/now_line"
                        android:layout_width="@dimen/epg_now_line"
                        android:layout_height="match_parent"
                        android:background="@color/accent"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom status line -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs"
        android:background="@drawable/osd_scrim_bottom">

        <TextView
            android:id="@+id/status_text"
            style="@style/TvBro.Text.Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="150 channels" />

        <TextView
            android:id="@+id/status_hint"
            style="@style/TvBro.Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/press_ok_to_turn_on" />

        <TextView
            android:id="@+id/status_epg"
            style="@style/TvBro.Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:visibility="gone"
            tools:text="Обновление EPG: разбор — 40% 12/316 каналов" />
    </LinearLayout>
</LinearLayout>
