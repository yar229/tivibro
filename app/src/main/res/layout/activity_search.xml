<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:background="@drawable/osd_scrim_bottom">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_player_button"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:padding="@dimen/spacing_md"
            android:src="@drawable/ic_arrow_back" />

        <EditText
            android:id="@+id/search_field"
            style="@style/TvBro.EditText"
            android:layout_width="0dp"
            android:layout_height="@dimen/search_field_height"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:hint="@string/search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            tools:text="sky" />

        <ImageView
            android:id="@+id/clear_button"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_player_button"
            android:contentDescription="@string/close"
            android:focusable="true"
            android:padding="@dimen/spacing_md"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/include_vod"
            style="@style/TvBro.NavItemLabel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@drawable/bg_group_item"
            android:focusable="true"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:text="@string/include_vod" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:focusable="true"
            android:padding="@dimen/spacing_sm"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty_view"
            style="@style/TvBro.Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/spacing_xl"
            android:text="@string/nothing_found"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        android:background="@drawable/osd_scrim_bottom">

        <TextView
            android:id="@+id/search_status"
            style="@style/TvBro.Text.Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="12 results" />
    </LinearLayout>
</LinearLayout>
