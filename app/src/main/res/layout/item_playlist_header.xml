<?xml version="1.0" encoding="utf-8"?>
<!-- Column names of the playlist table. Mirrors item_playlist.xml cell for cell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_xs">

    <TextView
        style="@style/TvBro.Text.Time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:maxLines="1"
        android:text="@string/playlist_name"
        android:textColor="@color/text_secondary" />

    <TextView
        style="@style/TvBro.Text.Time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1.2"
        android:maxLines="1"
        android:text="@string/playlist_type"
        android:textColor="@color/text_secondary" />

    <TextView
        style="@style/TvBro.Text.Time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="3.3"
        android:maxLines="1"
        android:text="@string/playlist_url"
        android:textColor="@color/text_secondary" />

    <TextView
        style="@style/TvBro.Text.Time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:gravity="end"
        android:maxLines="1"
        android:text="@string/playlist_actions"
        android:textColor="@color/text_secondary" />
</LinearLayout>
