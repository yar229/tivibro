<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@drawable/osd_scrim_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_player_button"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:nextFocusRight="@id/add_playlist"
            android:padding="@dimen/spacing_md"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/TvBro.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:textSize="@dimen/text_lg"
            android:text="@string/edit_playlists" />

        <TextView
            android:id="@+id/add_playlist"
            style="@style/TvBro.NavItemLabel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_group_item"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@id/back_button"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg"
            android:text="@string/add_playlist" />
    </LinearLayout>

    <!-- The table keeps the same column widths in the header and in every row, so the values
         stay under the name they belong to: identical weights, and the header carries the same
         inner padding the row does. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/osd_scrim_bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_sm">

        <TextView
            style="@style/TvBro.Text.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:maxLines="1"
            android:paddingStart="@dimen/spacing_md"
            android:text="@string/playlist_name" />

        <TextView
            style="@style/TvBro.Text.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1.2"
            android:maxLines="1"
            android:text="@string/playlist_type" />

        <TextView
            style="@style/TvBro.Text.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="3.3"
            android:maxLines="1"
            android:text="@string/playlist_url" />

        <TextView
            style="@style/TvBro.Text.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.7"
            android:gravity="end"
            android:maxLines="1"
            android:paddingEnd="@dimen/spacing_md"
            android:text="@string/playlist_actions" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlists_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:focusable="true"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_sm"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/empty_view"
            style="@style/TvBro.Text.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/spacing_xl"
            android:text="@string/no_playlists"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/osd_scrim_bottom"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/playlists_status"
            style="@style/TvBro.Text.Time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Playlists: 3" />
    </LinearLayout>
</LinearLayout>
