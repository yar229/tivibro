<?xml version="1.0" encoding="utf-8"?>
<!-- One playlist of the settings list. The column weights and the inner gaps repeat in
     item_playlist_header.xml, so every value sits under the name of its column. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playlist_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:nextFocusRight="@id/playlist_delete"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingEnd="@dimen/spacing_lg">

    <TextView
        android:id="@+id/playlist_name"
        style="@style/TvBro.Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="My playlist" />

    <TextView
        android:id="@+id/playlist_type"
        style="@style/TvBro.Text.Time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1.2"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Xtream Codes" />

    <TextView
        android:id="@+id/playlist_url"
        style="@style/TvBro.Text.Time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="3.3"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="http://example.com/playlist.m3u" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <!-- The row itself opens the editor, the remote gets here with a right press. -->
        <TextView
            android:id="@+id/playlist_delete"
            style="@style/TvBro.NavItemLabel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_group_item"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:nextFocusLeft="@id/playlist_row"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:text="@string/delete" />
    </LinearLayout>
</LinearLayout>
