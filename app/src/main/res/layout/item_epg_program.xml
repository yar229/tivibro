<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/epg_hour_width"
    android:layout_height="match_parent"
    android:layout_margin="1dp"
    android:background="@drawable/bg_epg_cell"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm">

        <TextView
            android:id="@+id/program_title"
            style="@style/TvBro.EpgProgramTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Live: Premier League" />

        <TextView
            android:id="@+id/program_time"
            style="@style/TvBro.EpgProgramTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="20:15 - 21:00" />
    </LinearLayout>
</FrameLayout>
